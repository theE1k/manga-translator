{
  "manifest_version": 3,
  "name": "Manga Translator",
  "version": "0.1.0",
  "description": "Translate manga / webtoon pages in place with local open-source models.",
  "icons": { "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "48": "icons/48.png", "96": "icons/96.png" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
